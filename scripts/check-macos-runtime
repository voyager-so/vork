#!/usr/bin/env python3
"""Check the Mac OS floor and emit a per-file, per-slice Mach-O inventory."""
import argparse
import json
from pathlib import Path
from runtime_platform import macos_manifest
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('tree', type=Path)
p.add_argument('--output', type=Path)
a = p.parse_args()
try:
    result = json.dumps(macos_manifest(a.tree), indent=2) + '\n'
except ValueError as error:
    p.error(str(error))
if a.output:
    a.output.write_text(result)
else:
    print(result, end='')
